# Configurações do banco de dados PostgreSQL que a aplicação irá se conectar
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DATABASE_NAME=postgres

# Para Desenvolvimento. Configurações do container do PostgreSQL do docker-compose. Usuário que será criado no banco de dados.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Configurações do RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASS=rabbitmq

# Número de threads para o ThreadPoolBean
APPLICATION_NUMBER_OF_THREADS=3

# O número máximo de threads para o pool de threads do Quarkus. Pool de threads global
APPLICATION_MAX_THREADS=3

# O nome passado ao ThreadFactory para identificar as threads do pool. Útil para monitoramento e debugging.
APPLICATION_EVENT_NAME=events-producer

# Número de iterações para cada execução
APPLICATION_NUMBER_THREAD_ITERATION=1

# Tamanho do lote para processamento. (limit do SELECT)
APPLICATION_BATCH_SIZE=10

# Em segundos, o tempo limite para a transação. Formato: java.time.Duration
APPLICATION_DEFAULT_TRANSACTION_TIMEOUT=60s

# Em segundos, o tempo limite para o envio HTTP.
# Nunca deve ser maior que o tempo limite da transação para evitar falhas desnecessárias.
APPLICATION_HTTP_SENDER_TIMEOUT=50

# Em minutos, a validade do lease do claim (status PROCESSING).
# Linhas cujo worker morreu sem gravar resultado voltam à fila após este período.
APPLICATION_CLAIM_LEASE_MINUTES=5
